; DrCom 校园网助手（Rust 版）配置文件示例
;
; 用法：复制为 drcom.ini，放到以下任一处（按此顺序查找，用第一个存在的）：
;   1. drcom-campus.exe 所在目录
;   2. 当前工作目录
;   3. %APPDATA%\DrComCampus\
; 安装到 Program Files 时第 3 处不需要管理员权限，推荐用它。
;
; 全部键都可以省略——省略 auth_server 时使用内置认证服务器 10.100.61.3，
; 账号和密码也可以在界面上直接输入。
;
; 注意：本文件不认识未列出的键名，写错名字会直接报错并指出行号。

[drcom]
; 认证服务器，可写多个（逗号或空格分隔），按顺序尝试
; auth_server = 10.100.61.3, 10.100.61.4

; 认证服务器端口，默认 61440
; svr_port = 61440

; 账号。留空则由界面输入
; account = 20230001

; 密码。留空则由界面输入——推荐留空，避免明文落盘
; password =

; 本机 IPv4 与 MAC。留空则自动选择物理有线/无线网卡
; local_ip = 10.0.0.9
; mac = 1C8341C584FD

; 主机名。留空则取环境变量 COMPUTERNAME
; hostname = MY-PC

; 主 DNS 与 DHCP 字段，一般不需要修改
; dns = 10.10.10.10
; dhcp = 0.0.0.0

; 本地绑定端口，默认 61440（原版行为）；填 0 让系统分配
; local_port = 61440

; 认证服务器 /32 主机路由：off(默认) | dry-run | manage
; manage 需要管理员权限，会临时改动系统路由表
; auth_route = off
