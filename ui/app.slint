import { Button, CheckBox, LineEdit, ScrollView, Palette } from "std-widgets.slint";

// Every colour in this file is derived from the platform colour scheme instead of
// being hard-coded. The built-in widgets (`Button`, `LineEdit`, `CheckBox`) already
// follow `Palette`, so painting our own cards white left dark mode with dark inputs
// on white surfaces — white-on-white text and an unreadable password field.
//
// `Palette.color-scheme` is the scheme Windows reports for this window: the winit
// backend reads it at window creation and follows the live `ThemeChanged` event, so
// switching Windows between light and dark re-paints the window without a restart.
//
// Exported so the backend can reach it through the generated `Theme` accessor.
export global Theme {
    // 0 = follow the system, 1 = force light, 2 = force dark. The backend sets this
    // from `DRCOM_THEME` for screenshots and for machines whose reported scheme is
    // wrong. Kept as an int so the Rust side never has to name a private Slint type.
    in-out property <int> scheme-override: 0;
    out property <bool> dark: scheme-override == 2
        || (scheme-override != 1 && Palette.color-scheme == ColorScheme.dark);

    out property <color> window-background: dark ? #1b1c21 : #f9f9ff;
    out property <color> surface-background: dark ? #24262c : #ffffff;
    out property <color> surface-border: dark ? #363943 : #e1e2ec;
    out property <color> hero-background: dark ? #232c3d : #eaf1ff;
    out property <color> divider: dark ? #363943 : #e1e2ec;
    out property <color> heading-text: dark ? #f0f1f5 : #1a1b20;
    out property <color> body-text: dark ? #d2d6df : #334155;
    out property <color> muted-text: dark ? #9aa0ad : #5e5f66;
    out property <color> accent: dark ? #8ab4f8 : #415f91;
    out property <color> brand-mark-background: dark ? #4a6ea8 : #415f91;
    out property <color> brand-mark-text: #ffffff;
    out property <color> online-text: dark ? #7fd39a : #286a48;
}

component Action inherits Button { height: 28px; }

component Surface inherits Rectangle {
    background: Theme.surface-background;
    border-color: Theme.surface-border;
    border-width: 1px;
    border-radius: 16px;
}
component Caption inherits Text {
    color: Theme.muted-text;
    font-size: 11px;
    overflow: elide;
}
export component AppTray inherits SystemTrayIcon {
    // Declared here rather than assigned to the builtin `tooltip` from Rust: a
    // tray-rooted component does not expose its parent's properties to the
    // language bindings. The hover text is the only thing a user can see once the
    // window has been hidden, so it has to be reachable from the backend.
    in-out property <string> tray-tooltip: "DrCom 校园网助手";
    icon: @image-url("../assets/icon-32.png");
    tooltip: tray-tooltip;
    title: "DrCom 校园网助手";
    callback show-requested();
    callback quit-requested();
    clicked => { show-requested(); }
    Menu {
        MenuItem { title: "显示主窗口"; activated => { show-requested(); } }
        MenuSeparator { }
        MenuItem { title: "退出程序"; activated => { quit-requested(); } }
    }
}
export component AppWindow inherits Window {
    title: "DrCom 校园网助手";
    icon: @image-url("../assets/icon-128.png");
    preferred-width: 520px;
    preferred-height: 390px;
    min-width: 480px;
    min-height: 360px;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 11px;
    background: Theme.window-background;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <string> connection-state: "未连接";
    in-out property <string> status-detail: "正在检测物理网卡…";
    in-out property <string> adapter-name: "尚未选择";
    in-out property <string> ipv4-address: "--";
    in-out property <string> mac-address: "--";
    in-out property <string> duration: "--";
    in-out property <string> gateway: "--";
    in-out property <string> dns: "--";
    in-out property <string> ipv6: "--";
    in-out property <string> campus-result: "未检测";
    in-out property <string> ipv4-result: "未检测";
    in-out property <string> ipv6-result: "未检测";
    in-out property <bool> probe-busy: false;
    in-out property <bool> auto-reconnect: true;
    in-out property <bool> auto-login: false;
    in-out property <bool> start-with-windows: false;
    // Mirrors the C# client's "关闭到托盘": with it on, the close button hides the
    // window and a successful login tucks it into the tray after three seconds;
    // with it off, closing the window really exits.
    in-out property <bool> minimize-to-tray: true;
    in-out property <string> config-status: "未保存";
    in-out property <bool> session-active: false;
    in-out property <bool> online: false;
    private property <bool> show-password: false;
    in-out property <bool> network-editor-visible: false;
    in-out property <bool> network-busy: false;
    in-out property <string> edit-adapter-name;
    in-out property <string> edit-ip;
    in-out property <string> edit-mask;
    in-out property <string> edit-gateway;
    in-out property <string> edit-dns;
    in-out property <string> network-message;
    callback connect-requested(string, string, bool);
    callback disconnect-requested();
    callback refresh-requested();
    callback probe-requested(int);
    callback copy-requested();
    callback export-requested();
    callback network-settings-requested();
    callback system-network-requested();
    callback apply-network-requested(string, string, string, string);
    callback save-requested(string, string, bool, bool, bool, bool);

    ScrollView {
        visible: !root.network-editor-visible;
        VerticalLayout {
            padding: 10px;
            spacing: 4px;
            Surface {
                min-height: 64px;
                background: Theme.hero-background;
                HorizontalLayout {
                    // Without this the layout uses its default `stretch`, which
                    // pins every fixed-height child (the logo, the button) to the
                    // top of the row while the text blocks fill the full height —
                    // the button then looks misaligned next to the centred state
                    // label. Centring gives each child its preferred height.
                    cross-axis-alignment: center;
                    padding: 8px;
                    spacing: 4px;
                    Rectangle {
                        width: 30px; height: 30px; border-radius: 10px; background: Theme.brand-mark-background;
                        Text { text: "D"; color: Theme.brand-mark-text; font-size: 16px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Text { text: "DrCom 校园网助手"; color: Theme.heading-text; font-size: 14px; font-weight: 600; }
                        Caption { text: root.status-detail; }
                        if root.session-active : Caption { text: root.online ? "保活运行中 · " + root.duration : "挑战 › 认证 › 保活"; }
                    }
                    Text { text: "● " + root.connection-state; color: root.online ? Theme.online-text : Theme.muted-text; font-size: 11px; vertical-alignment: center; }
                    Action {
                        width: 68px;
                        text: root.session-active ? "断开" : "连接";
                        primary: !root.session-active;
                        enabled: root.connection-state != "断开中";
                        clicked => {
                            if root.session-active { root.disconnect-requested(); }
                            else { root.connect-requested(root.username, root.password, root.auto-reconnect); }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 4px;
                Surface {
                    horizontal-stretch: 9;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        Text { text: "账号设置"; color: Theme.heading-text; font-weight: 600; }
                        LineEdit { height: 28px; placeholder-text: "校园网账号"; text <=> root.username; enabled: !root.session-active; }
                        HorizontalLayout {
                            spacing: 4px;
                            LineEdit { height: 28px;
                                placeholder-text: "密码"; text <=> root.password;
                                input-type: root.show-password ? InputType.text : InputType.password;
                                enabled: !root.session-active;
                                accepted => { if !root.session-active { root.connect-requested(root.username, root.password, root.auto-reconnect); } }
                            }
                            Action { width: 48px; text: root.show-password ? "隐藏" : "显示"; clicked => { root.show-password = !root.show-password; } }
                        }
                        HorizontalLayout {
                            CheckBox { height: 22px; text: "自动登录"; width: 88px; checked <=> root.auto-login; enabled: !root.session-active; }
                            CheckBox { height: 22px; text: "自动重连"; width: 88px; checked <=> root.auto-reconnect; enabled: !root.session-active; }
                        }
                        HorizontalLayout {
                            CheckBox { height: 22px; text: "开机启动"; width: 88px; checked <=> root.start-with-windows; enabled: !root.session-active; }
                            // Deliberately not disabled during a session: the close
                            // button reads this live, so it applies to the running
                            // session exactly as it does in the C# client.
                            CheckBox { height: 22px; text: "关闭到托盘"; width: 100px; checked <=> root.minimize-to-tray; }
                        }
                        Action { text: "保存设置"; enabled: !root.session-active; clicked => { root.save-requested(root.username, root.password, root.auto-login, root.auto-reconnect, root.start-with-windows, root.minimize-to-tray); } }
                        Action { text: "网络设置"; enabled: !root.session-active; clicked => { root.network-settings-requested(); } }
                        Caption { text: root.config-status; }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }
                Surface {
                    horizontal-stretch: 11;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        HorizontalLayout {
                            Text { text: "网络概览"; color: Theme.heading-text; font-weight: 600; vertical-alignment: center; }
                            Action { text: "刷新"; width: 48px; enabled: !root.session-active; clicked => { root.refresh-requested(); } }
                        }
                        Caption { text: "网卡：" + root.adapter-name; }
                        Text { text: "IPv4：" + root.ipv4-address; color: Theme.body-text; overflow: elide; }
                        Caption { text: "网关：" + root.gateway; }
                        Caption { text: "DNS：" + root.dns; }
                        Caption { text: "IPv6：" + root.ipv6; }
                        Rectangle { height: 1px; background: Theme.divider; }
                        HorizontalLayout {
                            Action { text: root.probe-busy ? "检测中…" : "双栈体检"; enabled: !root.probe-busy; clicked => { root.probe-requested(2); } }
                            Action { text: "复制诊断"; clicked => { root.copy-requested(); } }
                            Action { text: "导出诊断"; clicked => { root.export-requested(); } }
                        }
                        HorizontalLayout {
                            Action { text: "校内测试"; enabled: !root.probe-busy; clicked => { root.probe-requested(0); } }
                            Action { text: "公网测试"; enabled: !root.probe-busy; clicked => { root.probe-requested(1); } }
                        }
                        Caption { text: "校内：" + root.campus-result; }
                        Caption { text: "IPv4：" + root.ipv4-result; }
                        Caption { text: "IPv6：" + root.ipv6-result; }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }
            }
            HorizontalLayout {
                Caption {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    text: root.minimize-to-tray
                        ? "登录成功后自动进入托盘；关闭窗口最小化到托盘，可从托盘菜单退出。"
                        : "登录成功后窗口保持打开；关闭窗口即退出程序。";
                }
                Caption { text: "© 2026 ZincGlux"; vertical-alignment: center; }
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
        }
    }
    if root.network-editor-visible : ScrollView {
        VerticalLayout {
            padding: 16px;
            spacing: 6px;
            Text { text: "IPv4 静态网络设置"; font-size: 16px; font-weight: 600; color: Theme.heading-text; }
            Caption { text: "网卡：" + root.edit-adapter-name; }
            Caption { text: "配置此网卡的 IPv4 地址、网关和 DNS。"; }
            Caption { text: "IPv4 地址"; }
            LineEdit { height: 28px; text <=> root.edit-ip; enabled: !root.network-busy; }
            Caption { text: "子网掩码"; }
            LineEdit { height: 28px; text <=> root.edit-mask; enabled: !root.network-busy; }
            Caption { text: "默认网关"; }
            LineEdit { height: 28px; text <=> root.edit-gateway; enabled: !root.network-busy; }
            Caption { text: "首选 IPv4 DNS"; }
            LineEdit { height: 28px; text <=> root.edit-dns; enabled: !root.network-busy; }
            Text { text: root.network-message; font-size: 11px; color: Theme.accent; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 6px;
                Action { text: "返回"; enabled: !root.network-busy; clicked => { root.network-editor-visible = false; } }
                Action { text: "Windows 设置"; enabled: !root.network-busy; clicked => { root.system-network-requested(); } }
                Action { text: root.network-busy ? "应用中…" : "应用 IPv4 设置"; primary: true; enabled: !root.network-busy; clicked => { root.apply-network-requested(root.edit-ip, root.edit-mask, root.edit-gateway, root.edit-dns); } }
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
        }
    }
}
